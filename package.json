{
  "name": "io.appium.settings",
  "version": "8.0.3",
  "description": "App for dealing with Android settings",
  "keywords": [
    "android",
    "appium",
    "settings"
  ],
  "homepage": "https://github.com/appium/io.appium.settings",
  "bugs": {
    "url": "https://github.com/appium/io.appium.settings/issues"
  },
  "license": "Apache-2.0",
  "author": "Appium Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/appium/io.appium.settings.git"
  },
  "files": [
    "lib",
    "build/lib",
    "apks",
    "!.DS_Store",
    "NOTICE.txt",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./build/lib/index.js",
  "types": "./build/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/lib/index.d.ts",
      "import": "./build/lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "bump-gradle-version": "node scripts/gradle-version-update.mjs --package-version=${npm_package_version} && git add app/build.gradle",
    "lint": "./gradlew lint",
    "js:lint": "oxlint -c oxlint.config.mjs .",
    "js:lint:fix": "oxlint -c oxlint.config.mjs --fix .",
    "move-apks": "rm -rf apks && mkdir -p apks && cp app/build/outputs/apk/debug/settings_apk-debug.apk apks",
    "build": "tsc -b && ./gradlew clean assembleDebug && npm run move-apks",
    "js:build": "tsc -b",
    "prepare": "npm run build",
    "version": "npm run bump-gradle-version && npm run build",
    "clean": "npm run build -- --clean",
    "js:test": "node --enable-source-maps --test --test-timeout=60000 \"./build/test/unit/**/*.spec.js\"",
    "e2e-test": "node --enable-source-maps --test --test-force-exit --test-concurrency=1 --test-timeout=300000 \"./build/test/e2e/**/*.spec.js\"",
    "format": "oxfmt -c oxfmt.config.mjs .",
    "format:check": "oxfmt -c oxfmt.config.mjs --check ."
  },
  "dependencies": {
    "@appium/logger": "^2.0.0-rc.1",
    "asyncbox": "^6.0.1",
    "semver": "^7.5.4",
    "teen_process": "^4.0.4"
  },
  "devDependencies": {
    "@appium/oxc-config": "^1.1.0",
    "@appium/semantic-release-config": "^1.1.0",
    "@appium/tsconfig": "^1.2.0",
    "@appium/types": "^1.0.0-rc.1",
    "@types/node": "^26.0.0",
    "@types/sinon": "^22.0.0",
    "appium-adb": "^16.0.0",
    "sinon": "^22.0.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "npm": ">=10"
  }
}
